# 複製為 .env 後填入需要的 Key（只填 agent JSON 裡用到的廠商即可，llm 和 voice 共用這些 Key）

# Claude（provider: anthropic）
ANTHROPIC_API_KEY=

# Gemini（llm provider: gemini；voice 的 stt provider: gemini，tts provider: gemini_live / gemini）
# 注意：免費額度下專用 TTS 模型（tts provider: gemini）每天只有約 10 次，語音課請用 gemini_live
GEMINI_API_KEY=

# OpenAI 兼容（llm provider: openai_compat，用 api_key_env 指定讀哪個變量；voice 的 stt / tts provider: openai）
OPENAI_API_KEY=

# Azure Speech（發音課：發音評估 + 示範語音）。在 Azure 入口建立 Speech 資源後，從「金鑰與端點」複製
# Region 填資源所在區域的代號，例如 eastasia、southeastasia、eastus
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
